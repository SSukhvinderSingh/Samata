# ─── Pytest / Test Artifacts ───────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
test-results/
*.log

# ─── IDE ───────────────────────────────────────────────────────────────────
.idea/
